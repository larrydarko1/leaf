{
    "name": "leaf",
    "version": "3.0.1",
    "description": "A local-first, privacy-focused note-taking app for desktop with built-in AI assistance. Simple interface for reading and editing txt and md files, plus support for loading local LLMs (GGUF format) for private, on-device chat and assistance. All notes and AI interactions stay on your device.",
    "keywords": [
        "notes",
        "markdown",
        "electron",
        "local-ai",
        "llm",
        "privacy"
    ],
    "homepage": "https://github.com/larrydarko1/leaf#readme",
    "bugs": {
        "url": "https://github.com/larrydarko1/leaf/issues"
    },
    "license": "AGPL-3.0-only",
    "author": {
        "name": "Lorenzo Mazzola",
        "email": "hello@larrydarko.dev"
    },
    "type": "module",
    "main": "out/main/index.js",
    "desktopName": "leaf.desktop",
    "repository": {
        "type": "git",
        "url": "https://github.com/larrydarko1/leaf.git"
    },
    "scripts": {
        "predev": "install-electron",
        "dev": "electron-vite dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "vue-tsc -b && electron-vite build",
        "build:electron": "npm run build && electron-builder",
        "build:mac": "npm run build && electron-builder --mac --publish never",
        "build:linux": "npm run build && electron-builder --linux --publish never",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:dup": "jscpd src --config .jscpd.json --reporters console",
        "format": "prettier --write \"src/**/*.{ts,vue,scss,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,vue,scss,json}\"",
        "audit:check": "node scripts/check/check-audit.mjs",
        "code:check": "node scripts/check/check-code-style.mjs",
        "dead:check": "node scripts/check/check-dead-code.mjs",
        "declorder:check": "node scripts/check/check-declaration-order.mjs",
        "dup:check": "node scripts/check/check-duplication.mjs",
        "error:check": "node scripts/check/check-error-handling.mjs",
        "html:check": "node scripts/check/check-html-standards.mjs",
        "i18n:check": "node scripts/check/check-i18n.mjs",
        "ipc:check": "node scripts/check/check-ipc-standards.mjs",
        "pipeline:check": "node scripts/check/check-pipeline.mjs",
        "pkg:check": "node scripts/check/check-package-json.mjs",
        "refactor:check": "node scripts/check/check-refactoring.mjs",
        "scss:check": "node scripts/check/check-scss-standards.mjs",
        "security:check": "node scripts/check/check-electron-security.mjs",
        "test:check": "node scripts/check/check-testing.mjs",
        "stylelint": "stylelint \"src/**/*.{scss,vue}\"",
        "stylelint:fix": "stylelint \"src/**/*.{scss,vue}\" --fix",
        "prepare": "husky",
        "test:coverage": "npx vitest run --coverage",
        "ci:check": "npm run audit:check && npm run lint && npm run format:check && npm run stylelint && npm run pkg:check && npm run pipeline:check && npm run code:check && npm run declorder:check && npm run html:check && npm run scss:check && npm run refactor:check && npm run ipc:check && npm run security:check && npm run error:check && npm run dup:check && npm run dead:check && npm run i18n:check && npm run test:coverage && npm run test:check && npm run build"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.1",
        "@codemirror/commands": "^6.10.3",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/language": "^6.12.3",
        "@codemirror/language-data": "^6.5.2",
        "@codemirror/search": "^6.6.0",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.41.0",
        "@huggingface/transformers": "^4.2.0",
        "@lezer/highlight": "^1.2.3",
        "dompurify": "^3.4.11",
        "electron-log": "~5.4.3",
        "marked": "^18.0.9",
        "node-llama-cpp": "^3.15.1",
        "onnxruntime-node": "^1.24.2",
        "vue": "^3.5.17",
        "vue-i18n": "^11.4.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint/js": "^10.0.1",
        "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
        "@types/node": "^24.0.13",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vitest/coverage-v8": "^4.1.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vue/compiler-sfc": "^3.5.41",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.9.0",
        "electron": "^43.4.0",
        "electron-builder": "^26.4.0",
        "electron-vite": "^5.0.0",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-vue": "^10.8.0",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jscpd": "^5.0.16",
        "jsdom": "^30.0.1",
        "jsonc-eslint-parser": "^3.1.0",
        "knip": "^6.32.2",
        "lint-staged": "^16.4.0",
        "postcss-html": "^2.0.0",
        "prettier": "^3.8.1",
        "sass-embedded": "^1.100.0",
        "stylelint": "^17.13.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-declaration-strict-value": "^1.11.1",
        "stylelint-scss": "^7.2.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.1",
        "vite": "^7.0.0",
        "vitest": "^4.1.4",
        "vue-tsc": "^3.2.0",
        "yaml": "^2.9.0"
    },
    "engines": {
        "node": ">=24",
        "npm": ">=10"
    },
    "os": [
        "darwin",
        "linux"
    ],
    "private": true,
    "packageManager": "npm@11.11.0",
    "build": {
        "appId": "com.leaf.app",
        "productName": "Leaf",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "package.json",
            "build/icon.png",
            {
                "from": "out",
                "to": "out",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "afterPack": "./build/afterPack.cjs",
        "extraResources": [
            "models/**",
            "assets/**"
        ],
        "asarUnpack": [
            "models/**",
            "node_modules/onnxruntime-node/**"
        ],
        "dmg": {
            "background": "build/dmg-background.png",
            "iconSize": 100,
            "iconTextSize": 14,
            "title": "${productName} ${version}",
            "contents": [
                {
                    "x": 180,
                    "y": 260
                },
                {
                    "x": 480,
                    "y": 260,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "mac": {
            "category": "public.app-category.productivity",
            "identity": null,
            "artifactName": "${productName}-${version}-${arch}.${ext}",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                }
            ]
        },
        "linux": {
            "target": [
                "AppImage",
                "deb",
                "rpm",
                "tar.gz"
            ],
            "category": "Utility",
            "maintainer": "Lorenzo Mazzola",
            "vendor": "Lorenzo Mazzola",
            "synopsis": "A local-first, privacy-focused note-taking app with on-device AI",
            "syncDesktopName": true
        }
    },
    "lint-staged": {
        "*.{ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{scss,vue}": [
            "stylelint --fix"
        ],
        "*.{scss,json,md}": [
            "prettier --write"
        ]
    }
}
